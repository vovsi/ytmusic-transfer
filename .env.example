# --- YouTube Music (source) ---
# Preferred: OAuth (auto-refreshing, doesn't expire/invalidate like browser
# cookies do). Get a client_id/secret from Google Cloud Console (OAuth client
# type "TVs and Limited Input devices") and fill in both below. First run
# opens a browser + shows a code to confirm access, then caches a refresh
# token in ytmusic_oauth.json (gitignored) — no more copying needed after
# that. See README.md -> "Getting YouTube Music credentials" for exact steps.
YTMUSIC_OAUTH_CLIENT_ID=
YTMUSIC_OAUTH_CLIENT_SECRET=

# Fallback: raw request headers copied from your browser's DevTools while
# logged in to music.youtube.com. Only used if the two OAuth vars above are
# empty. Must stay wrapped in double quotes (spans multiple lines). Must
# include "Cookie", "X-Goog-AuthUser", and "Authorization" (looks like
# "SAPISIDHASH <timestamp>_<hash>", NOT computed automatically by
# ytmusicapi). Expires/gets invalidated much sooner than OAuth.
YTMUSIC_HEADERS_RAW="Cookie: PASTE_YOUR_COOKIE_HERE
X-Goog-AuthUser: 0
Authorization: PASTE_YOUR_SAPISIDHASH_HERE
User-Agent: PASTE_YOUR_USER_AGENT_HERE"

# Optional. Only needed if "Liked Music" is on a YouTube Brand Account /
# secondary channel (switched via the avatar menu on music.youtube.com,
# NOT a separate Google login). If get_liked_songs finds 0 tracks despite
# correct headers, get this ID from myaccount.google.com/brandaccounts ->
# select the channel -> the number in the URL after /b/.
YTMUSIC_USER_ID=

# --- SoundCloud (destination) ---
# Your personal OAuth token copied from DevTools (Authorization request header,
# looks like "OAuth 2-XXXXXX-XXXXXXXXX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"). Required.
SOUNDCLOUD_OAUTH_TOKEN=

# Optional. DataDome anti-bot cookie, copied from DevTools -> Application ->
# Cookies -> soundcloud.com -> "datadome". Needed to get past the captcha
# challenge that blocks playlist-write (PUT) requests. Expires ~1h, re-copy
# if writes start failing with a 403 pointing at geo.captcha-delivery.com.
SOUNDCLOUD_DATADOME_COOKIE=

# Optional. Leave empty and the script will auto-discover a client_id from
# soundcloud.com's own web assets. Set it manually only if auto-discovery fails.
SOUNDCLOUD_CLIENT_ID=

# Optional. Name of the destination playlist (created automatically if missing).
SOUNDCLOUD_PLAYLIST_NAME=Favorite

# Optional. Minimum match confidence (0-100) to accept a SoundCloud search
# result as the same song. Lower = more matches but more false positives.
MATCH_THRESHOLD=75

# Optional. Delay between SoundCloud API requests, in milliseconds.
REQUEST_DELAY_MS=300
